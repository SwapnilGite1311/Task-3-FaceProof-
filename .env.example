# ─────────────────────────────────────────────────────────────────────────────
# FaceProof — environment configuration
# Copy to `.env` in the repo root:  cp .env.example .env
# Every service (api, web, contracts) reads this single root file.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Core ─────────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Publicly reachable base URL of the API. Used to build temporary image URLs
# for reverse-image-search providers that require a URL instead of an upload
# (e.g. SerpApi / Google Lens). For local development expose port 4000 with a
# tunnel (`cloudflared tunnel --url http://localhost:4000` or `ngrok http 4000`)
# and paste the https URL here. Leave as localhost only when your provider
# accepts direct image uploads (e.g. TinEye).
PUBLIC_BASE_URL=http://localhost:4000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://faceproof:faceproof@localhost:5432/faceproof?schema=public

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Reverse image search ─────────────────────────────────────────────────────
# Provider id. Supported: serpapi_google_lens | serpapi_google_reverse_image | tineye
#   serpapi_google_lens          -> best coverage of social platforms; needs PUBLIC_BASE_URL
#                                   or object storage so the image is reachable by URL.
#   serpapi_google_reverse_image -> classic Google reverse image search via SerpApi.
#   tineye                       -> accepts a direct multipart image upload (no public URL
#                                   or storage required), exact/derivative matching only.
REVERSE_SEARCH_PROVIDER=serpapi_google_lens
REVERSE_SEARCH_API_KEY=
# TinEye uses HTTP Basic auth; set these instead of REVERSE_SEARCH_API_KEY when
# REVERSE_SEARCH_PROVIDER=tineye.
TINEYE_API_USERNAME=
TINEYE_API_PASSWORD=
REVERSE_SEARCH_TIMEOUT_MS=45000
REVERSE_SEARCH_MAX_RESULTS=40

# ── Temporary image hosting (only needed by URL-based search providers) ──────
# STORAGE_PROVIDER=local  -> the API serves the image itself from PUBLIC_BASE_URL
#                            behind a single-use, expiring, HMAC-signed token.
# STORAGE_PROVIDER=s3     -> any S3 compatible bucket (AWS S3, Cloudflare R2, MinIO).
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ── Blockchain (Polygon Amoy testnet) ────────────────────────────────────────
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_EXPLORER_URL=https://amoy.polygonscan.com
# Private key of a funded Amoy account (0x-prefixed, 64 hex chars).
# Fund it from https://faucet.polygon.technology  — NEVER commit a real key.
BLOCKCHAIN_PRIVATE_KEY=
FACEPROOF_CONTRACT_ADDRESS=
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_CONFIRMATION_TIMEOUT_MS=180000
# Optional: Polygonscan API key, only used by `npm run verify:amoy` in contracts/
POLYGONSCAN_API_KEY=

# ── Matching thresholds ──────────────────────────────────────────────────────
# Minimum combined confidence required before a candidate is reported as a match.
MATCH_CONFIDENCE_THRESHOLD=0.62
# Maximum number of reverse-search candidates that are downloaded and analysed.
MATCH_MAX_CANDIDATES_ANALYSED=12

# ── Face pipeline ────────────────────────────────────────────────────────────
FACE_MODELS_DIR=./models
FACE_MIN_CONFIDENCE=0.5

# ── Uploads / security ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
# 32+ char secret used to sign temporary image URLs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=change-me-to-a-long-random-string-please-0123456789

# ── Demo mode ────────────────────────────────────────────────────────────────
# MUST stay false for real verifications. When true the reverse-search and
# blockchain modules are replaced by clearly-labelled stubs and every produced
# record is flagged `demo: true` and refused by /verify.
DEMO_MODE=false
