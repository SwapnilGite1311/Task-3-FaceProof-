{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "noEmit": true,
    "types": ["node", "mocha", "chai"]
  },
  "include": ["./*.ts", "./test/**/*.ts", "./typechain-types/**/*.ts"],
  "exclude": ["node_modules", "artifacts", "cache", "dist"]
}
