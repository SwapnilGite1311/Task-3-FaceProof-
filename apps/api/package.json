{
  "name": "@faceproof/api",
  "version": "1.0.0",
  "private": true,
  "description": "FaceProof verification API: face analysis, reverse-image discovery, evidence hashing and blockchain anchoring.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev --name init",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "doctor": "tsx scripts/doctor.ts",
    "prisma:reset": "dotenv -e ../../.env -- prisma migrate reset --force"
  },
  "dependencies": {
    "@faceproof/shared": "*",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.19.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "fastify": "^5.6.1",
    "pdfkit": "^0.17.2",
    "pino": "^9.13.1",
    "sharp": "^0.34.4",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.4",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.907.0",
    "@aws-sdk/s3-request-presigner": "^3.907.0"
  }
}
